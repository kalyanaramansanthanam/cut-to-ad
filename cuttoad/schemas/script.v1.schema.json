{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "rationale", "scenes"],
  "properties": {
    "schema_version": { "const": "v1" },
    "rationale": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "duration_sec", "description", "camera", "mood", "cta"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "description": { "type": "string" },
          "camera": { "type": "string" },
          "mood": { "type": "string" },
          "cta": { "type": "boolean" }
        }
      }
    }
  }
}
