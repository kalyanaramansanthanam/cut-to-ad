{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "created_at_utc", "input", "steps", "warnings"],
  "properties": {
    "schema_version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["running", "success", "failed"] },
    "created_at_utc": { "type": "string" },
    "completed_at_utc": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["video_path", "product", "audience", "max_scenes"],
      "properties": {
        "video_path": { "type": "string" },
        "product": { "type": "string" },
        "audience": { "type": "string" },
        "max_scenes": { "type": "integer", "minimum": 1 }
      }
    },
    "steps": {
      "type": "object",
      "required": ["analyze", "script", "validate", "generate", "assemble", "report"],
      "properties": {
        "analyze": { "type": "string" },
        "script": { "type": "string" },
        "validate": { "type": "string" },
        "generate": { "type": "string" },
        "assemble": { "type": "string" },
        "report": { "type": "string" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
