{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_video",
    "visual_style",
    "mood",
    "pacing",
    "lighting",
    "scenes"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "source_video": { "type": "string" },
    "mode": { "type": "string" },
    "visual_style": { "type": "string" },
    "mood": { "type": "string" },
    "pacing": { "type": "string" },
    "lighting": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "timestamp_start_sec", "timestamp_end_sec", "description"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "timestamp_start_sec": { "type": "number", "minimum": 0 },
          "timestamp_end_sec": { "type": "number", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
